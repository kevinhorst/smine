# ACDSL doctrine rules — the central declaration file.
#
# One rule per line. Anchors are regexes over repo paths and decide which
# files a rule governs; where a rule is declared carries no meaning. Inline
# //acdsl: markers in Go source remain legal but are reserved for rules that
# genuinely concern only their own file — the read hook already delivers
# every rule on the files it governs, so co-location adds nothing here.
# Task contracts live in their own *.acdsl files and are retired by renaming
# the file away from the extension.
# reach= declares deployment reach (internal/reach grammar): "global" (would
# bind in any repo) or a comma-separated repo-name list; this repo is named
# "smine" (the default) — no self-keyword, smine never matches a sync target.
# Global rules are the future distribution manifest; anchors may still be
# repo-local until distribution validates portability.

//acdsl:ACDSL-GOLANG-ERR-001 errorf-prefix reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="^internal/xp.*\.go$" anchor-not="(_test\.go$|/testdata/)" why="Error constructor messages carry the Component.Method: prefix (RULE-GOLANG-ERR-001) — fmt.Errorf(\"Load: reading %s: %w\", path, err), never \"failed to ...\""
//acdsl:ACDSL-GOLANG-TEST-001 test-schema reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="^internal/xp.*_test\.go$" anchor-not="/testdata/" why="Table tests execute via t.Run(test._id, ...) with the _id/_shouldPass testCase schema (RULE-GOLANG-TEST-001..005) — never tt.name or ad-hoc subtest names"
//acdsl:ACDSL-GOLANG-EXEC-001 forbid-call reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="^(cmd|internal)/.*\.go$" anchor-not="(_test\.go$|/testdata/|^internal/shell/)" pkg="os/exec" func="Command" why="Child processes run under a context deadline — internal/shell.Run for short commands, exec.CommandContext under the routine runner's own deadlines for multi-hour cells; a raw exec.Command has no timeout and can wedge the caller forever"
//acdsl:ACDSL-GOLANG-STATE-001 literal-owner reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="\.go$" anchor-not="(_test\.go$|/testdata/)" literal="context.json" allowed="^(cmd/rules|internal/server|internal/contextdocs|internal/repos)/" why="context/context.json has one producer, the internal/contextdocs renderer (cmd/rules generate, config server, worktree creation); internal/server reads it for coverage, internal/repos probes deployed copies; any other writer desyncs the generated file"
//acdsl:ACDSL-GOLANG-DOCS-001 lint-tags reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="(^|/)rules/go(_test)?\.md$" config=".golangci.yml" projected="false" empty="ok" why="A style guide's Covered-by linter claims must be true of the repo's golangci config — a [lint] tag tells reviewers to skip the rule, so a claim naming a disabled linter means the rule is checked by nobody (replaces the go repo's check-tags.sh)"
//acdsl:ACDSL-GOLANG-FMT-001 gofmt reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="\.go$" anchor-not="(/testdata/|^vendor/)" why="Every Go file is gofmt-formatted — run gofmt -w before committing; this gate replaces the raw Makefile gofmt line"
//acdsl:ACDSL-GOLANG-FUNC-001 func-signature reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="\.go$" anchor-not="(_test\.go$|/testdata/|^vendor/)" why="Signatures follow RULE-GOLANG-FUNC-001 — ctx context.Context is the first parameter and is named ctx, error is the last return value, at most 3 return values"
//acdsl:ACDSL-GOLANG-COMMENT-001 comment-cap reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="^(cmd|internal)/.*\.go$" anchor-not="(_test\.go$|/testdata/)" max="1" why="A comment block in non-test Go runs one line at most (RULE-GOLANG-COMMENT-001) — how-it-works text lives in the directory's README"
//acdsl:ACDSL-GOLANG-ENUM-001 exhaustive-switch reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="\.go$" anchor-not="(_test\.go$|/testdata/|^vendor/)" why="Every switch over a domain enum names all members (ACTION-IMPL-INTEG-005) — no default that silently swallows new ones"
//acdsl:ACDSL-GOLANG-CONFIG-001 literal-gate reach="claude-configs" anchor="^cmd/(globalcontext|readgate|skillcontext|planmodecontext|acdslhook|toolpolicy|skillinvokegate|worktreecreate|worktreewriteguard|sessiontitle|skillhelp|playsound|heartbeatfeed)/.*\.go$" anchor-not="(_test\.go$|/testdata/)" exempt="(^|/)protocol\.go$" ignored="0o644,0o755,2" why="A hook binary carries no behavioural literal — timeouts, caps, prefixes, patterns and texts are catalog settings (internal/components) rendered into ~/.claude/hooks/config.json; only protocol facts stay constants, in the package's protocol.go, so the exemption is a reviewable file list"
//acdsl:ACDSL-SKILL-001 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" mode="version-sync" why="Every skill keeps two version surfaces in sync — the model's frontmatter version and changelog[0].version; skillgraph.Check refuses any model where they differ, so a bump touches both in one save"
//acdsl:ACDSL-SKILL-016 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" mode="runtime-meta" why="Runtime placement is consistent — bypass stands alone and needs docker: always, a Script: pointer needs enableDelegation: never, the rendered placement keys are never authored; skillgraph.Check refuses the model"
//acdsl:ACDSL-SKILL-002 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" anchor-not="skills/agent-only/" mode="frontmatter" why="SKILL.md frontmatter carries single-line name/description/author/version; the description states what the skill does with a Trigger on clause, and an ## Args section requires an Args — summary in the description"
//acdsl:ACDSL-SKILL-003 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" mode="allowed-tools" sort="required" why="allowed-tools is one comma-separated line in the settings-allowlist dialect, normalized — plain tools first alphabetical, then Bash/MCP entries grouped and sorted; Bash uses space wildcards, never colon forms; Read/Edit/Write path rules use a gate-matchable spec (~/…/**, //…/**, @repos/**)"
//acdsl:ACDSL-SKILL-004 skill-context anchor="^skills/([^/]+/)+[^/]+\.cue$" index="context/context.json" needs="context/context.json" why="A skill's acdsl-context: declaration stays resolvable — every declared entry ID exists in the generated context index and every glob matches at least one entry; a declaration under the legacy context: key (Claude Code's native field) or a stale one silently injects nothing"
//acdsl:ACDSL-SKILL-005 skill-entries anchor="^skills/([^/]+/)+[^/]+\.cue$" why="A skill model loads — CUE schema and skillgraph.Check hold, format-3 fields, links, titles and sources included — and its entries name their leaf dir, back a gate/hook/schema channel with a resolvable pointer, keep inline enumerations to 6 items; deploy and the eval address entries by id"
//acdsl:ACDSL-SKILL-006 skill-map anchor="^skills/.*/context-map\.json$" index="context/context.json" needs="context/context.json" why="A skill's context-map lanes stay resolvable subsets of its frontmatter declaration — a stale lane silently injects the wrong slice or falls back to the full set"
//acdsl:ACDSL-SKILL-015 severity-table anchor="^skills/.*/severity-fixtures\.json$" why="A skill's severity table is a complete, overlap-free function of its axes and its ratified fixtures resolve through it — a gap or a stale fixture silently re-grades every finding"
//acdsl:ACDSL-SKILL-009 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" anchor-not="skills/agent-only/" mode="argument-hint" why="An arg-bearing skill's argument-hint is the args-only example naming every ## Args arg and never leads with /<leaf> — the harness UI shows the skill name already, so a leading command duplicates it"
//acdsl:ACDSL-SKILL-010 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" anchor-not="skills/agent-only/" mode="args-table" why="## Args is the 4-column syntax-index table (Arg backticked, Effect one line ≤160 runes) with deep semantics in the owning body entries; bullet form only for ≤2 selector args"
//acdsl:ACDSL-SKILL-011 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" anchor-not="skills/agent-only/" mode="routing" why="Every skill carries the typed routing block — purpose, the Disambiguation table, testable preconditions and pipeline edges that agree across skills — so help, the skill map and the hand-off check read data, not prose"
//acdsl:ACDSL-SKILL-012 skill-meta anchor="^skills/([^/]+/)+[^/]+\.cue$" anchor-not="skills/agent-only/" mode="context-links" why="No bare context-entry id in body prose — rules are named in plain language as links per the link-convention rule; a bare id reads authoritative while the entry may not be in context"
//acdsl:ACDSL-SKILL-013 skill-model anchor="^skills/(([^/]+/)+[^/]+\.cue|vocabulary\.cue)$" why="Formal clauses stay resolvable — preds parse, atom sources are arg, session, environment or runtime bound to an enforce capture, and on tier: strict every atom resolves against vocabulary.cue plus the skill's atoms; the model derives mechanically, a vocabulary change re-checks every skill"
//acdsl:ACDSL-SKILL-007 skill-plan-template anchor="^skills/([^/]+/)+[^/]+\.cue$" why="A plan-producing skill's plan-template: declaration names a [payload] entry whose template (payloads/<entry-id>.md) opens with TLDR, keeps the plan catalog's section order, and marks every non-catalog section as an override — the plan interface of rules/plan.md is machine-checked at authoring time"
//acdsl:ACDSL-SHELL-002 bash32-compat reach="global" anchor="\.sh$" anchor-not="(/testdata/|^vendor/)" why="Scripts launched by hooks or launchd run under macOS bash 3.2 — no declare -A, mapfile/readarray, case expansion, |&, or parameter transformation (the launchd lesson)"
//acdsl:ACDSL-SHELL-003 file-baseline anchor="\.sh$" anchor-not="(/testdata/|^vendor/|^evals/|^plans/)" baseline="acdsl/sh-baseline.txt" why="No new shell scripts — the repo is moving away from shell; the tracked .sh set is frozen in acdsl/sh-baseline.txt (ACTION-IMPL-ARCH-002) — the gate rejects a script outside the list, a deleted script's line is removed by hand; any addition needs user approval plus a baseline entry"
//acdsl:ACDSL-JSON-002 jsonschema anchor="^sessions/[^/]+/[0-9]{4}-W[0-9]{2}/[^/]+\.json$" schema="skills/smine/smine-batch/reference/session.schema.json" empty="ok" needs="skills/smine/smine-batch/reference/session.schema.json" why="Session record JSON conforms to the session schema — the config server's week views and deep links select on its fields; a hand-edited or stale JSON drifts from its md"
//acdsl:ACDSL-JSON-003 jsonschema reach="global" anchor="^acdsl/policy\.json$" schema="acdsl/policy.schema.json" empty="ok" needs="acdsl/policy.schema.json" why="acdsl/policy.json conforms to its schema — a malformed mode or scope list silently degrades the self-management gate"
//acdsl:ACDSL-JSON-004 jsonschema anchor="^plans/.*/reviews/round-[0-9]+/review\.json$" schema="skills/quality/railroad-review/reference/review.schema.json" empty="ok" needs="skills/quality/railroad-review/reference/review.schema.json" why="Committed railroad round reviews conform to the review.json schema — the fix plan loop, DoD report and re-review rounds parse them; a malformed disposition or severity silently corrupts the fix plan"
//acdsl:ACDSL-JSON-005 jsonschema anchor="^skills/.*/eval/definition\.json$" schema="skills/skillroutine/skillroutine-eval/reference/definition.schema.json" empty="ok" needs="skills/skillroutine/skillroutine-eval/reference/definition.schema.json" why="Skill eval definitions conform to the definition schema (4.0) — the one eval interface: cmd/skilleval init builds every eval and A/B run from it and the Tests tab reads it; drift strands eval runs mid-flight"
//acdsl:ACDSL-JSON-008 jsonschema anchor="^skills/.*/eval/golden/scoring\.json$" schema="skills/skillroutine/skillroutine-eval/reference/scoring.schema.json" empty="ok" needs="skills/skillroutine/skillroutine-eval/reference/scoring.schema.json" why="Golden scoring files conform to the scoring schema — the golden judge brief, the skilleval fold and the Tests tab read the guide, weights and bounds from them; a drifted file silently rescores every run"
//acdsl:ACDSL-SMINE-001 rules-check anchor="^context/((actions|rules|facts)/.*\.md|aspects\.json)$" mode="validate" projected="false" needs="context/aspects.json" why="context entries pass cmd/rules validate — ACTION/RULE/FACT contract violations break the context sync and the generated context file; this gate replaces the raw Makefile validate line"
//acdsl:ACDSL-GOLANG-GEN-001 evalgen-bounds reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="^cmd/acdsl/verifiers/[^/]+/main\.go$" why="Verifiers stay inside acdsl/evalgen.json bounds — line count, stdlib/internal/go.mod-only imports; generation may never add a dependency (Band D is a user call)"
//acdsl:ACDSL-PLAN-001 plan-format reach="global" anchor="^plans/([^/]+/)?[^/]+/design/[^/]+\.md$" empty="ok" why="Persisted plans under a plan dir's design/ follow rules/plan.md — the plan dir sits in a feature folder, TLDR is the first section, a Changelog section exists, and plans created from 2026-10-04 on keep RULE-PLAN-002 section order and RULE-PLAN-098 entry order"
//acdsl:ACDSL-SMINE-003 id-grammar anchor="\.acdsl$" taxonomy="context/context.json" needs="context/context.json" why="Doctrine ids follow KIND-SCOPE[-TOPIC]-NNN with taxonomy-registered segments (context/actions/README.md, Rule identity) — the naming grammar is a gate, not review vigilance"
//acdsl:ACDSL-SMINE-004 model-token anchor="^skills/(.+/)?agents/[^/]+\.md$" keys="model" role="subagent" line="^model:" projected="false" why="Agent definitions name a subagent model the harness runs as named — an unresolved token silently runs the session model, a forbidden one is stopped by heartbeat (FACT-CLAUDE-HARNESS-009)"
//acdsl:ACDSL-SMINE-005 model-token anchor="^skills/.*/workflows/.*\.js$" keys="model" role="subagent" projected="false" why="Workflow agent() literals name a subagent model the harness runs as named (FACT-CLAUDE-HARNESS-009)"
//acdsl:ACDSL-SMINE-006 model-token anchor="^skills/([^/]+/)+[^/]+\.cue$" keys="arms" role="session" line="^(argument-hint:|\s*/skillroutine-eval )" projected="false" why="Example eval arms resolve against availableModels — a dead arm token launches the session model (FACT-CLAUDE-HARNESS-009)"
//acdsl:ACDSL-SMINE-007 model-token anchor="^skills/([^/]+/)+[^/]+\.cue$" keys="judge,lanes,station,models[],models,model" role="subagent" line="^(argument-hint:|\s*/skillroutine-eval )" projected="false" why="Example subagent model args name a subagent model (FACT-CLAUDE-HARNESS-009)"
//acdsl:ACDSL-SMINE-008 model-token anchor="^(skills/.*/eval/definition\.json|routines/[^/]+/routine\.json)$" keys="arms" role="session" projected="false" why="Eval and routine arm tokens resolve against availableModels (FACT-CLAUDE-HARNESS-009)"
//acdsl:ACDSL-SMINE-009 model-token anchor="^(skills/.*/eval/definition\.json|routines/[^/]+/routine\.json)$" keys="judge,lanes,station,models" role="subagent" projected="false" why="Eval and routine subagent model args name a subagent model (FACT-CLAUDE-HARNESS-009)"
//acdsl:ACDSL-SMINE-010 model-token anchor="^((cmd|internal)/.*\.(go|sh)|routines/.*\.plist\.template|settings/claude_code/.*\.json)$" anchor-not="(_test\.go$|/testdata/|/tests/)" ids="true" role="session" projected="false" why="Model ids in code, routine plists and settings templates resolve against availableModels — claude-opus-4-8 in the nightly routine ran a substituted model (FACT-CLAUDE-HARNESS-009)"
//acdsl:ACDSL-GOLANG-LINT-001 golangci reach="claude-configs,copy_trader_flask_server_llm,gotests-v2,peek-mcp" anchor="\.go$" anchor-not="(/testdata/|^vendor/)" why="Anchored Go files pass the repo's golangci-lint config (differential — changed lines only); findings name the linter, fixes go to the code or (with a reason) the config, never a bare //nolint"
//acdsl:ACDSL-RUNBOOK-001 runbook-format reach="global" anchor="^plans/[^/]+/[^/]+/runbooks/.*\.bru$" empty="ok" why="Runbook collections follow rules/runbooks.md — every request file carries a non-empty docs block and an assert block"
//acdsl:ACDSL-SKILL-008 forbid-phrase anchor="^skills/quality/railroad-review/(railroad-review\.cue|workflows/[a-z-]+\.js|eval/definition\.json)$" pattern="(?i)wait(ing)? for (this|the|each) (wave|batch)( of \S+)? to (complete|finish)" why="Worker dispatch never imposes completion-barrier waves (ROUND-023) — the 2026-09-06 eval run serialized 23 refuters into waves of 4"
//acdsl:ACDSL-SKILL-017 forbid-phrase anchor="^skills/(([^/]+/)+[^/]+\.cue|.*/workflows/.*\.js)$" pattern="make -C <[^>]+> acdsl|/bin/bash <" why="Skill text never prescribes a command form the tool-policy gate always denies — railroad probe verdicts as make -C <worktree> acdsl and probe runs as /bin/bash <script> burned 150+ denials across six review runs"
//acdsl:ACDSL-SKILL-018 interpretation-format anchor="^evals/[^/]+/[^/]+/interpretation\.md$" why="Eval interpretations follow rules/skills.md RULE-SKILL-020 — at most 8 bullets of at most 160 runes, nothing else, so the Tests tab shows every bullet whole"
//acdsl:ACDSL-SKILL-014 forbid-phrase anchor="^skills/quality/railroad-review/(railroad-review\.cue|workflows/[a-z-]+\.js)$" pattern="(?i)token conduct|as few (tool )?calls|never read a file over|do not load tools via toolsearch" why="Worker prompts never limit tool calls, call counts, or read sizes — the 15.2.0 token-conduct block suppressed findings; the workflow layer holds spawn control, prompt generation and agent-return folding; binary-computable dispatcher args come from smine-rules; doctrine lives in the SKILL body"
