    { "id": "SKILL-FEXPLORE-006", "axis": "self", "phase": "P1", "rule": "Design by measurement — when an option hinges on a data distribution/capability, write the runnable query and hand it to the user; the result becomes a binding fact.", "source": "evals/fexplore-2026-08-27-2/skills/default.md:38" },
