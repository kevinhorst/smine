+/// `--dry-run`: the /close check — the same steps previewed, nothing touched, exit 3 on the first refusal.
+#[test]
+fn ops_remove_dry_run() {
+    let mut f = Fixture::new();
+    f.branch("claude/session", "main");
+    let session_wt = f.worktree("claude/session", "session");
+    f.lock(&session_wt);
+    f.branch("claude/dirty", "main");
+    let dirty_wt = f.worktree("claude/dirty", "dirty");
+    write_at(&dirty_wt, "base.txt", "edited\n");
+
+    // /close shape from inside the worktree: previewed, nothing removed.
+    let out = f.run_in(
+        &session_wt,
+        &[
+            "--format",
+            "text",
+            "remove",
+            "--dry-run",
+            "--delete-branch",
+            "claude/session",
+        ],
+    );
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let text = String::from_utf8_lossy(&out.stdout).into_owned();
+    assert!(text.contains("would remove"), "{text}");
+    assert!(
+        text.contains("would delete branch claude/session"),
+        "{text}"
+    );
+    assert!(session_wt.exists());
+    assert!(
+        f.git(&["branch", "--list", "claude/session"])
+            .contains("claude/session")
+    );
+
+    // json: the preview outcomes, never `removed`.
+    let out = f.run_in(
+        &session_wt,
+        &[
+            "--format",
+            "json",
+            "remove",
+            "--dry-run",
+            "--delete-branch",
+            "claude/session",
+        ],
+    );
+    assert!(out.status.success());
+    let result: Value = serde_json::from_slice(&out.stdout).expect("json");
+    assert_eq!(result["lines"][0]["outcome"], "would_remove");
+    assert_eq!(result["lines"][1]["outcome"], "would_delete_branch");
+
+    // a step that would be skipped: exit 3, the refusal once on stderr, nothing on stdout.
+    let out = f.run(&[
+        "--format",
+        "text",
+        "remove",
+        "--dry-run",
+        "--delete-branch",
+        "claude/dirty",
+    ]);
+    assert_eq!(out.status.code(), Some(3));
+    let stderr = String::from_utf8_lossy(&out.stderr).into_owned();
+    assert!(stderr.contains("skipped:"), "{stderr}");
+    assert!(stderr.contains("dirty(1)"), "{stderr}");
+    assert_eq!(stderr.matches("dirty(1)").count(), 1, "{stderr}");
+    assert!(String::from_utf8_lossy(&out.stdout).trim().is_empty());
+    assert!(dirty_wt.exists());
+
+    // the real remove afterwards still works — the dry run changed nothing.
+    let out = f.run_in(
+        &session_wt,
+        &[
+            "--format",
+            "json",
+            "remove",
+            "--delete-branch",
+            "claude/session",
+        ],
+    );
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let result: Value = serde_json::from_slice(&out.stdout).expect("json");
+    assert_eq!(result["lines"][0]["outcome"], "removed");
+    assert_eq!(result["lines"][1]["outcome"], "branch_deleted");
+    assert!(!session_wt.exists());
+}
