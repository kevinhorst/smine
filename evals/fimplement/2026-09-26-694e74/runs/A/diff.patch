+/// `--dry-run` previews the same steps `remove` would take, touching nothing; a refusal exits 3 instead of a
+/// `skipped` line, and a real `remove` afterwards proves the dry runs changed nothing.
+#[test]
+fn ops_remove_dry_run() {
+    let mut f = Fixture::new();
+    f.branch("claude/session", "main");
+    let session_wt = f.worktree("claude/session", "session");
+    f.lock(&session_wt);
+
+    // /close shape: cwd inside the worktree being removed, --dry-run --delete-branch, text mode.
+    let out = f.run_in(
+        &session_wt,
+        &[
+            "--format",
+            "text",
+            "remove",
+            "--dry-run",
+            "--delete-branch",
+            "claude/session",
+        ],
+    );
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let text = String::from_utf8_lossy(&out.stdout).into_owned();
+    assert!(text.contains("would remove"), "{text}");
+    assert!(
+        text.contains("would delete branch claude/session"),
+        "{text}"
+    );
+    assert!(session_wt.exists());
+    assert!(
+        f.git(&["branch", "--list", "claude/session"])
+            .contains("claude/session")
+    );
+
+    // same shape in json: outcomes would_remove, would_delete_branch.
+    let out = f.run_in(
+        &session_wt,
+        &[
+            "--format",
+            "json",
+            "remove",
+            "--dry-run",
+            "--delete-branch",
+            "claude/session",
+        ],
+    );
+    assert!(out.status.success());
+    let result: Value = serde_json::from_slice(&out.stdout).expect("json");
+    assert_eq!(result["lines"][0]["outcome"], "would_remove");
+    assert_eq!(result["lines"][1]["outcome"], "would_delete_branch");
+
+    // dirty worktree: exit 3, stderr has skipped: and dirty(1) exactly once, stdout empty, worktree kept.
+    write_at(&session_wt, "base.txt", "dirty\n");
+    let out = f.run_in(
+        &session_wt,
+        &["remove", "--dry-run", "--delete-branch", "claude/session"],
+    );
+    assert_eq!(out.status.code(), Some(3));
+    let stderr = String::from_utf8_lossy(&out.stderr).into_owned();
+    assert!(stderr.contains("skipped:"), "{stderr}");
+    assert_eq!(stderr.matches("dirty(1)").count(), 1, "{stderr}");
+    assert!(out.stdout.is_empty());
+    assert!(session_wt.exists());
+    f.git_in(&session_wt, &["checkout", "--", "base.txt"]);
+
+    // real remove afterwards: removed, proving the dry runs changed nothing.
+    let out = f.run_in(
+        &session_wt,
+        &["remove", "--delete-branch", "claude/session"],
+    );
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    assert!(String::from_utf8_lossy(&out.stdout).contains("removed"));
+    assert!(!session_wt.exists());
+    assert!(f.git(&["branch", "--list", "claude/session"]).is_empty());
+}
