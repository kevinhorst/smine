{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "skillroutine-eval manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "skillMd", "inputs", "runs"],
  "properties": {
    "skill": { "type": "string", "minLength": 1 },
    "skillMd": { "type": "string", "minLength": 1 },
    "contextFiles": { "type": "array", "items": { "type": "string" }, "default": [] },
    "qualityContext": { "type": "array", "items": { "type": "string" }, "default": [] },
    "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "output", "model"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "effort": { "type": "string" },
              "mode": { "type": "string" },
              "telemetry": { "type": "string" }
            }
          },
          "userFindings": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": false, "required": ["notes"], "properties": { "notes": { "type": "string" } } }
            ]
          }
        }
      },
      "minItems": 1
    },
    "output": { "type": "string" },
    "md": { "type": "boolean", "default": false }
  }
}
