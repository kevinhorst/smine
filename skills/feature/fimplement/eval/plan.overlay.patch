+```go
+// arePathArgsInsideRoots reports whether every non-flag argument resolves
+// inside roots.
+func arePathArgsInsideRoots(cwd string, args []string, roots []string) bool {
+	for _, arg := range args {
+		if strings.HasPrefix(arg, "-") {
+			continue
+		}
+		if !IsInsideRoots(cwd, arg, roots) {
+			return false
+		}
+	}
+	return true
+}
+
+// isPathFlagCallAllowed pre-empts the engine's flag bail: the engine asks for
+// any flagged cp even under a matching allow rule, so a call the gate would
+// hand over — acceptEdits scope or a settings allow match — is allowed here
+// when its flags are safe and every path lies inside the write roots.
+func isPathFlagCallAllowed(input *HookInput, policy *Policy, grants *Grants, home string, call *resolvedCall) bool {
+	if !policy.isSafePathFlagCall(call) {
+		return false
+	}
+	if !arePathArgsInsideRoots(input.Cwd, call.args, writeRoots(input, policy, grants, home)) {
+		return false
+	}
+
+	isAcceptEditsScope := input.PermissionMode == permissionModeAcceptEdits && policy.isAcceptEditsHead(call.head)
+	isRuleAllowed := grants.matchAllow(toolNameBash, &input.ToolInput) != nil
+	return isAcceptEditsScope || isRuleAllowed
+}
+```
