+### Safe path-flag check (modified)
+location: `cmd/toolpolicy/policy.go`
+
+```diff
+ type Policy struct {
+ 	AcceptEditsHeads   []string            `json:"accept_edits_heads"`
+ 	...
+ 	PassthroughTools   []string            `json:"passthrough_tools"`
++	PathFlagHeads      map[string]string   `json:"path_flag_heads"`
+ 	ProtectedPaths     []string            `json:"protected_paths"`
+```
+
+```go
+// isSafePathFlagCall reports whether call is a path_flag_heads command that
+// carries at least one flag, every flag a short cluster of the head's listed
+// letters — no long option, no target-directory form.
+func (p *Policy) isSafePathFlagCall(call *resolvedCall) bool {
+	letters, isPathFlagHead := p.PathFlagHeads[call.head]
+	if !isPathFlagHead {
+		return false
+	}
+
+	hasFlag := false
+	for _, arg := range call.args {
+		if !strings.HasPrefix(arg, "-") {
+			continue
+		}
+		cluster := strings.TrimPrefix(arg, "-")
+		if cluster == "" || strings.Trim(cluster, letters) != "" {
+			return false
+		}
+		hasFlag = true
+	}
+	return hasFlag
+}
+```
