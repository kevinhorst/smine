{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "smine batch summary",
  "description": "Machine-readable form of one sessions/{scope}/*batch-*.md report. Derived from real batches (personal 01/08, work 10/19): table columns and header prose vary by era, so everything except session id is optional.",
  "type": "object",
  "required": [
    "batch",
    "sessions"
  ],
  "additionalProperties": false,
  "definitions": {
    "snippet": {
      "type": "object",
      "required": [
        "kind",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "violation",
            "fix",
            "context"
          ]
        },
        "lang": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "description": "verbatim from transcript/plan/diff — never reconstructed"
        },
        "source": {
          "enum": [
            "transcript",
            "plan",
            "diff"
          ]
        }
      }
    }
  },
  "properties": {
    "batch": {
      "type": "object",
      "required": [
        "scope",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "description": "folder name under sessions/ — the attributed repo's roster name, or default"
        },
        "title": {
          "type": "string",
          "description": "short human batch title (5-9 words), names the batch's centerpiece"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "file": {
          "type": "string",
          "description": "repo-relative path of the source md"
        },
        "analyzedDate": {
          "type": "string",
          "description": "ISO date the batch was analyzed"
        },
        "dateRange": {
          "type": "string",
          "description": "covered session date range, verbatim from the header"
        },
        "theme": {
          "type": "string"
        },
        "sourceNote": {
          "type": "string",
          "description": "data-source / method note from the header"
        },
        "analyzerVersion": {
          "type": "string",
          "description": "smine skill version from the batch header's Analyzer line, e.g. \"1.8\""
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "title": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "description": "from [Repo, Type] title tags where present"
          },
          "type": {
            "type": "string",
            "description": "session type tag, e.g. Fix, Implementation, Feature-Design"
          },
          "signal": {
            "type": "string",
            "description": "signal/verdict column verbatim, e.g. 'yes (high)', 'exemplar'"
          },
          "skipped": {
            "type": "boolean"
          },
          "skipReason": {
            "type": "string"
          },
          "dataGaps": {
            "type": "string",
            "description": "compaction boundaries, missing turns, rendering losses"
          },
          "invoked_skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "skill names invoked during the session, from the report's 'Skills invoked:' line"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dimension",
                "summary"
              ],
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "enum": [
                    "skill-candidate",
                    "workflow-candidate",
                    "routine-candidate",
                    "skill-report-card",
                    "feature-design",
                    "memory",
                    "rule",
                    "doc-drift",
                    "harness-friction",
                    "exemplar",
                    "context-use",
                    "other"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "quotes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "snippets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/snippet"
                  }
                },
                "contextUse": {
                  "type": "object",
                  "required": [
                    "kind",
                    "ruleId"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "violated-despite-present",
                        "needed-not-present",
                        "present-irrelevant"
                      ]
                    },
                    "channel": {
                      "type": "string",
                      "description": "skill-context | global-context | lang | acdsl | plan | pack-read | subagent | none"
                    },
                    "ruleId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "description": "per-session permission decisions from session_events (permission_granted/permission_denied) and the optional telemetry permissions view; absent when the session had no permission activity",
            "properties": {
              "granted": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "tool",
                    "command"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "tool": {
                      "type": "string",
                      "description": "the tool that was prompted and granted, e.g. Bash, WebFetch, an mcp__ server tool"
                    },
                    "command": {
                      "type": "string",
                      "description": "the concrete command/argument that was granted (Bash command line, fetched domain, tool input); empty when the harness exposed no detail"
                    },
                    "decision": {
                      "enum": [
                        "prompted_once",
                        "prompted_always",
                        "granted_event"
                      ],
                      "description": "prompted_once/prompted_always from the telemetry permissions view; granted_event when only the event stream carried the grant"
                    }
                  }
                }
              },
              "denied": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "tool",
                    "command"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "tool": {
                      "type": "string"
                    },
                    "command": {
                      "type": "string"
                    }
                  }
                },
                "description": "prompted-and-rejected tool/command pairs — negative evidence only, never a deny/ask proposal"
              },
              "telemetry_present": {
                "type": "boolean",
                "description": "true when the telemetry permissions view was available for this session (auto-allowed vs prompted counts); false when only the event stream was mined"
              }
            }
          },
          "frustration": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "quote": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                }
              }
            }
          },
          "positive": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "quote": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                }
              }
            }
          },
          "agent": {
            "enum": [
              "claude",
              "codex"
            ],
            "description": "producing agent; absent = claude (pre-1.20 files)"
          },
          "context": {
            "type": "object",
            "description": "used-context record (Claude sessions); absent for Codex and pre-1.20 files",
            "properties": {
              "injected": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "global": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "skill": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "skill",
                        "ids"
                      ],
                      "properties": {
                        "skill": {
                          "type": "string"
                        },
                        "ids": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "via": {
                          "enum": [
                            "marker",
                            "gate"
                          ]
                        }
                      }
                    }
                  },
                  "lang": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "required": [
                        "lang",
                        "ids"
                      ],
                      "properties": {
                        "lang": {
                          "type": "string"
                        },
                        "ids": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "coverage": {
                          "enum": [
                            "complete",
                            "partial"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "acdsl_rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "file",
                    "ids"
                  ],
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "plan_rules": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "pack_reads": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subagent_context": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "touched_files": {
                "type": "object",
                "properties": {
                  "reads": {
                    "type": "integer"
                  },
                  "writes": {
                    "type": "integer"
                  }
                }
              },
              "honored": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sessionIds",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "sessionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  }
}
