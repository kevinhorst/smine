enableDelegation: "always"
frontmatter: [{
	key:   "name"
	value: " smine-routines"
}, {
	key:   "description"
	value: " Turn one solution direction of a mined problem into one routines change task — returns it, writes nothing. Trigger on `plan` from smine-problems. Args — plan: the problem JSON and direction index arrive in the prompt."
}, {
	key:   "author"
	value: " Kevin Horst"
}, {
	key:   "version"
	value: " 6.1.1"
}, {
	key:   "format"
	value: " 2"
}, {
	key:   "argument-hint"
	value: " \"plan\""
}, {
	key:   "allowed-tools"
	value: " Read"
}, {
	key:   "acdsl-context"
	value: " ACTION-IMPL-ARCH-004, RULE-SKILL-012, RULE-SKILL-013, RULE-SKILL-014"
}]
preamble: """
	# smine: routine planner

	Turns one solution direction of a mined problem into one routines change task — reads the problem, the direction and the
	live routine surface, returns `{task, reason}`, writes nothing.
	"""
requires: ["mining"]
sections: [{
	title: "Routing"
	blocks: [{
		routing: {
			pipeline: {
				edges: [{
					kind:  "spawnedBy"
					skill: "smine-problems"
				}, {
					kind:     "to"
					skill:    "skillroutine-create"
					optional: true
					route:    "routine"
				}]
				note: "per solution direction; returns one change task or null to smine-problems, which writes it"
			}
			preconditions: ["spawned by smine-problems with a problem JSON and a direction index in the prompt", "returns only — creates no schedule, cron entry, or file"]
			purpose: "turns one solution direction of a mined problem into one routines change task; returns it, never writes."
			routes: [{
				for: "synthesize problems from session records"
				use: "/smine-problems"
			}, {
				for: "a skill or workflow edit for this direction"
				use: "the smine-skills planner"
			}]
		}
	}]
}, {
	title: "Args"
	blocks: [{
		args: {
			bullets: true
			rows: [{
				name:   "plan"
				effect: "positional — the problem JSON and the direction index arrive in the prompt; return `{task, reason}`, write nothing."
			}]
		}
	}]
}, {
	title: "Knowledge"
	blocks: [{
		entry: {
			id:        "SKILL-SMINEROUTINES-CLASSIFY-001"
			role:      "def"
			statement: "Cadence is nightly, weekly, or on-idle — from evidence, not invented."
			title:     "Cadence"
		}
	}, {
		entry: {
			id:        "SKILL-SMINEROUTINES-CLASSIFY-002"
			role:      "def"
			statement: "Wrapped task is skill or workflow routine invokes."
			title:     "Wrapped task"
		}
	}, {
		entry: {
			id: "SKILL-SMINEROUTINES-TASK-001"
			items: [{
				fence: {
					body: """
						{"id": "routines/<slug>", "kind": "routines", "title": "", "problem": "", "backlog": "", "evidence": [{"session": "", "quote": "", "finding": 0}], "fix": "", "sessions": [], "target": "", "change": "", "notes": ""}

						"""
					info:   "json"
					marker: "```"
				}
			}, {
				label:  "Applies"
				marker: "*"
				text:   "`id` = `routines/<slug>`; `kind` = `routines`; `sessions` = the problem's evidence session ids; `target` = the routine dir or manifest."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "`problem` = one plain sentence ≤ 160 runes stating what is wrong for a reader who was not in the session."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "no ids, shas, paths, line numbers, code spans or parenthesised counts — the task check refuses them."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "`backlog` = the matched `B-NNN`, omitted when the problem matched no backlog item."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "`fix` = why this routine fixes it, ≤ 240 characters."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "`evidence` = `[{session, quote, finding}]` from the problem's evidence notes, at most 3."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "each quote a verbatim excerpt ≤ 160 characters, `finding` the note's finding index."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "a longer note cut at a clause boundary with a trailing `…`, never paraphrased."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "`change` one imperative sentence."
			}, {
				label:  "Applies"
				marker: "*"
				text:   "`notes` = cadence, wrapped task, local-or-cloud placement, the /skillroutine-create routine route mechanics."
			}]
			role:      "def"
			statement: "Change task: one JSON object keyed as the block below — smine-problems writes it to `.smine-run/changes/routines-<slug>.json`."
			title:     "Change task"
		}
	}, {
		entry: {
			id:        "SKILL-SMINEROUTINES-CLASSIFY-003"
			pred:      "needs_local_tooling => routes_local"
			role:      "rule"
			statement: "Candidate needing local MCP servers, local files, or local git MUST route to local daemon (`claude -p` + /loop; cloud routines can't reach local tooling — checklist item 11)."
			title:     "Execution constraint"
		}
	}, {
		entry: {
			id:        "SKILL-SMINEROUTINES-CLASSIFY-003b"
			pred:      "cloud_safe => routes_cloud"
			role:      "rule"
			statement: "Fully cloud-safe candidate MUST route to scheduled task."
			title:     "Cloud-safe routing"
		}
	}, {
		entry: {
			id: "SKILL-SMINEROUTINES-SETUP-005b"
			items: [{
				label:  "Applies"
				marker: "*"
				text:   "the returned task's `title`, `problem` and `fix`."
			}]
			pred:      "language_set => authored_in_language"
			role:      "rule"
			statement: "When profile's `language:` set and not `en`, skill MUST author user-visible prose fields in that language."
			title:     "Fields to author"
		}
	}, {
		entry: {
			id:        "SKILL-SMINEROUTINES-SETUP-005c"
			role:      "rule"
			statement: "Authored prose MUST follow profile body's register and glossary, in that language."
			title:     "Register match"
		}
	}, {
		entry: {
			id:        "SKILL-SMINEROUTINES-SETUP-005d"
			pred:      "not ids_translated"
			role:      "rule"
			statement: "NEVER translate ids, targets, file paths, code, dates, tags, schema keys, or status values. Absent profile means English, unchanged."
			title:     "Language field exclusions"
		}
	}, {
		entry: {
			id: "SKILL-SMINEROUTINES-SETUP-006"
			custom: ["todo:unmeasured"]
			pred:      "audience_casual => not jargon_used"
			role:      "quality"
			statement: "When `audience:` is `casual`, prose fields above MUST carry no file paths, no rule/FACT/ACDSL IDs, no schema or taxonomy jargon — say what changes for user."
			title:     "Casual presentation"
		}
	}, {
		entry: {
			id: "SKILL-SMINEROUTINES-SETUP-006b"
			custom: ["todo:unmeasured"]
			pred:      "audience_casual => technical_anchors_in_fields"
			role:      "quality"
			statement: "Technical anchors MUST go in `target`, `change` and `notes` instead."
			title:     "Casual presentation anchors"
		}
	}]
	kind: "context"
}, {
	title: "Plan"
	blocks: [{
		entry: {
			id:        "SKILL-SMINEROUTINES-PLAN-001"
			role:      "step"
			statement: "READ the problem and direction index from the prompt; READ the live routine surface per the context entries above."
			title:     "Read problem"
		}
	}, {
		entry: {
			id:        "SKILL-SMINEROUTINES-PLAN-002"
			role:      "step"
			statement: "COMPOSE the [change task](#skill-smineroutines-task-001) for the direction; a direction no routine carries yields `task: null` with the reason."
			title:     "Compose task"
		}
	}, {
		entry: {
			id:        "SKILL-SMINEROUTINES-PLAN-003"
			role:      "stop"
			statement: "RETURN `{task, reason}` as the final message ⇒ STOP: write nothing."
			title:     "Return"
		}
	}]
}, {
	title: "Model"
	blocks: [{
		model: {
			effort: "low"
			reason: "compose one routine artifact plan for one direction from the kept knowledge"
			tier:   "mid-tier"
		}
	}]
}]
smoke: {
	expect: {}
	invoke: "plan Problem: {\"id\":\"smoke-unrun-skill-edits\",\"title\":\"Skill edits ship without a run\",\"problem\":\"Skill edits in 6 of 10 sessions were deployed without running the skill once; two broke an enforce check on the next real run and cost a full retry.\",\"cost\":\"6 sessions, 1 repo, 30 turns, 1800 s\",\"backlog\":\"\",\"evidence\":[{\"session\":\"00000000-0000-0000-0000-000000000000\",\"note\":\"enforce check failed on the first real run\",\"finding\":0}],\"directions\":[{\"title\":\"Nightly smoke sweep\",\"direction\":\"Run make skill-smoke nightly for every skill whose <leaf>.cue changed since the last sweep.\",\"feasibility\":\"make skill-smoke exists\",\"tasteFit\":\"mechanical verdict, no model judge\"}]}. Direction index: 0."
}
