+      "kind": "rule",
+      "scope": "COMMIT",
+      "enforcement": "review",
+      "content": {
+        "bullets": [
+          "A commit subject starts with a scope prefix and a colon:\n  ```\n  <scope>: <Description>\n  ```",
+          "When the whole commit concerns a single symbol, name it as a second prefix:\n  ```\n  <scope>: <Symbol>: <Description>\n  ```",
+          "New-package imports are the sole exception — they carry no prefix (see RULE-COMMIT-010)."
+        ],
+        "statement": "A commit subject starts with a scope prefix and a colon: `<scope>: <Description>`."
+      },
+      "reach": "global",
+      "version": "1.0",
+      "source": "/Users/devuser/GolandProjects/smine/context/rules/commits.md",
+      "origin": "baseline"
+    },
