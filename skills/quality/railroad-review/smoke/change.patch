+// Package smokereview is the change under review in railroad-review's smoke
+// fixture; nothing imports it.
+package smokereview
+
+// Clamp bounds value to the inclusive range low..high.
+func Clamp(value, low, high int) int {
+	switch {
+	case value < low:
+		return low
+	case value > high:
+		return high
+	default:
+		return value
+	}
+}
diff --git a/internal/smokereview/clamp_test.go b/internal/smokereview/clamp_test.go
