+// Package smokedebug is diagnose-debug's smoke fixture; nothing imports it.
+package smokedebug
+
+// Average returns the arithmetic mean of values, 0 for none.
+func Average(values []int) float64 {
+	if len(values) == 0 {
+		return 0
+	}
+
+	sum := 0
+	for _, value := range values {
+		sum += value
+	}
+	return float64(sum / len(values))
+}
