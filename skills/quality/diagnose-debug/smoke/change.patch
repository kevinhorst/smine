+package smokedebug
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestAverage(t *testing.T) {
+	values := []int{2, 3}
+	average := Average(values)
+	assert.InDelta(t, 2.5, average, 1e-9)
+}
