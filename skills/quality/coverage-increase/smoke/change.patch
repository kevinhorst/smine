+// Package smokecov is coverage-increase's smoke fixture; nothing imports it.
+package smokecov
+
+// Sign names the sign of n.
+func Sign(n int) string {
+	switch {
+	case n < 0:
+		return "negative"
+	case n == 0:
+		return "zero"
+	default:
+		return "positive"
+	}
+}
