+// Package smokeverdict is code-verdict's smoke fixture; nothing imports it.
+package smokeverdict
+
+import "sync"
+
+// CountWords counts each word, one goroutine per word.
+func CountWords(words []string) map[string]int {
+	counts := make(map[string]int)
+	var wg sync.WaitGroup
+	for _, word := range words {
+		wg.Go(func() {
+			counts[word]++
+		})
+	}
+	wg.Wait()
+	return counts
+}
