{
  "mcpServers": {
    "peek-mcp": {
      "type": "stdio",
      "command": "{{PEEK_MCP}}",
      "args": [
        "start",
        "--transport=stdio",
        "--depth=100",
        "--claude-home={{HOME}}/.claude",
        "--codex-home={{HOME}}/.codex",
        "--control-port=0"
      ],
      "env": {
        "MAX_MCP_OUTPUT_TOKENS": "125000"
      }
    }
  }
}
