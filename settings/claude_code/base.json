{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000",
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "64",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "64",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "rerere.enabled",
    "GIT_CONFIG_VALUE_0": "false",
    "GOFLAGS": "-timeout=5m"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": []
  },
  "model": "claude-fable-5-1",
  "availableModels": [
    "claude-opus-5-5",
    "claude-opus-5-5[1m]",
    "claude-opus-5",
    "claude-opus-5[1m]",
    "claude-fable-5",
    "claude-fable-5[1m]",
    "claude-fable-5-1",
    "claude-fable-5-1[1m]",
    "claude-sonnet-5",
    "claude-sonnet-5[1m]",
    "claude-sonnet-5-5",
    "claude-sonnet-5-5[1m]"
  ],
  "enforceAvailableModels": true,
  "disabledMcpjsonServers": [
    "clickup",
    "claude-in-chrome",
    "claude-preview"
  ],
  "worktree": {
    "baseRef": "head"
  },
  "disableAllHooks": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "autoMemoryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": false,
  "disableBundledSkills": false,
  "skillOverrides": {
    "schedule": "off",
    "auto-mode-setup": "off",
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "batch": "off",
    "claude-api": "off",
    "code-review": "off",
    "dataviz": "off",
    "debug": "off",
    "deep-research": "off",
    "design": "off",
    "design-sync": "off",
    "doctor": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "keybindings-help": "off",
    "run": "off",
    "security-review": "off",
    "simplify": "off",
    "skill-doctor": "off",
    "slides": "off",
    "update-config": "off",
    "verify": "off"
  },
  "disableRemoteControl": true,
  "subagentPromptCacheTtl": "1h",
  "cleanupPeriodDays": 180
}
