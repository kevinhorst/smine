{
  "hooks": {
    "DirectoryAdded": [
      {
        "smineId": "gate-directoryadded-toolpolicy",
        "smineName": "Tool policy",
        "smineVersion": "1.1.0",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bin/toolpolicy -ledger ~/.claude/tool-policy/denials.jsonl -gate-repo {{REPO_DIR}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "smineId": "gate-permissionrequest-toolpolicy",
        "smineName": "Tool policy",
        "smineVersion": "1.1.0",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bin/toolpolicy -ledger ~/.claude/tool-policy/denials.jsonl -gate-repo {{REPO_DIR}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "smineId": "gate-posttooluse-toolpolicy",
        "smineName": "Tool policy",
        "smineVersion": "1.1.0",
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bin/toolpolicy -ledger ~/.claude/tool-policy/denials.jsonl -gate-repo {{REPO_DIR}}",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "smineId": "gate-pretooluse-toolpolicy",
        "smineName": "Tool policy",
        "smineVersion": "1.1.0",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bin/toolpolicy -ledger ~/.claude/tool-policy/denials.jsonl -gate-repo {{REPO_DIR}}",
            "timeout": 10
          }
        ]
      },
      {
        "smineId": "gate-pretooluse-skillinvokegate",
        "smineName": "Skill invoke gate",
        "smineVersion": "1.0.1",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bin/skillinvokegate",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "smineId": "gate-userpromptsubmit-toolpolicy",
        "smineName": "Tool policy",
        "smineVersion": "1.1.0",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bin/toolpolicy -ledger ~/.claude/tool-policy/denials.jsonl -gate-repo {{REPO_DIR}}",
            "timeout": 10
